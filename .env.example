# Nexa Agent — Environment Variables
# Copy this file to .env and fill in your values.
# Copyright (c) 2026 Dearly Febriano Irwansyah

# === Provider Selection ===
# Choose: openai, openrouter, ollama, llamacpp, lmstudio, vllm, custom
NEXA_PROVIDER=ollama

# === API Keys ===
# Required for OpenAI / OpenRouter. Local providers (ollama, llamacpp) accept any value.
OPENAI_API_KEY=sk-your-key-here
# NEXA_API_KEY=alternative-key-name

# === Model ===
# The model to use (provider-specific).
NEXA_MODEL=llama3.2

# === Custom Base URL (for custom or local providers) ===
# Ollama:       http://localhost:11434/v1
# llama.cpp:    http://localhost:8080/v1
# LM Studio:    http://localhost:1234/v1
# vLLM:         http://localhost:8000/v1
# OpenRouter:   https://openrouter.ai/api/v1
# NEXA_BASE_URL=http://localhost:11434/v1

# === Runtime ===
# NEXA_HOME=~/.nexa
# NEXA_WORKSPACE=./nexa-workspace
