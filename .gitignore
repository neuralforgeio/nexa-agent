# Nexa Agent — .gitignore
# Copyright (c) 2026 Dearly Febriano Irwansyah

# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/
build/
dist/

# production
*.tsbuildinfo
next-env.d.ts

# env files (never commit secrets)
.env
.env*
!.env.example

# database (runtime data)
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm

# logs
dev.log
server.log
*.log

# runtime workspace (agent file/terminal tool sandbox)
nexa-workspace/

# uploads & downloads (user-supplied, not source)
upload/
download/

# test screenshots at repo root
/nexa-*.png

# python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.python-version

# panel defaults (not part of Nexa Agent source)
skills/
examples/
Caddyfile

# misc
.DS_Store
Thumbs.db
*.zip
.cache/
coverage/

# editor
.vscode/
.idea/
*.swp
*.swo

# vercel
.vercel
