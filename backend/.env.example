# Nexa Agent — Environment Variables
# Copy this file to .env and fill in your values.
# Copyright (c) 2026 Dearly Febriano Irwansyah

# Required: Your OpenAI API key (or OpenAI-compatible provider key).
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Custom base URL for OpenAI-compatible endpoints.
# Examples:
#   OpenRouter: https://openrouter.ai/api/v1
#   Local Ollama: http://localhost:11434/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional: The model identifier to use (default: gpt-4o).
# NEXA_MODEL=gpt-4o

# Optional: Runtime home directory (default: ~/.nexa).
# NEXA_HOME=~/.nexa

# Optional: File/terminal tool sandbox directory (default: ./nexa-workspace).
# NEXA_WORKSPACE=./nexa-workspace
