generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A conversation session. Scopes a thread of messages.
model NexaSession {
  id        String       @id @default(cuid())
  title     String       @default("untitled session")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  messages  NexaMessage[]

  @@index([updatedAt])
}

/// A single message inside a session transcript.
model NexaMessage {
  id         String     @id @default(cuid())
  sessionId  String
  role       String // user | assistant | tool | system
  content    String
  toolName   String?
  toolCallId String?
  createdAt  DateTime   @default(now())
  session    NexaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// Long-term memory persisted across sessions (~/.nexa/memory equivalent).
model NexaMemory {
  id        String   @id @default(cuid())
  kind      String // note | fact | preference | skill
  content   String
  createdAt DateTime @default(now())

  @@index([kind])
}
